{% if environmentVariables.environment == "dev" %}
  {% include "./devBanner.njk" %}
{% endif %}

{% if environmentVariables.environment == "staging" %} 
  {% include "./stagingBanner.njk" %} 
{% endif %}
<div class="masthead fbox centre-with-padding">
  <!-- Masthead -->
  <a class="logo" href="/">{% include "./logo.njk" %}</a>
  <a class="no-decoration" href="/about">About</a>
  <a class="no-decoration" href="/blog.html">Blog</a>
  <a class="no-decoration" href="/work">Work</a>
  <a class="no-decoration" href="/contact">Contact</a>
</div>
<style>

.masthead {
  box-sizing: border-box;
  border-bottom: 5px solid var(--fg);
  padding: 0;
  margin-bottom: 0;
  gap: 0;
  font-variation-settings: 
    "wght" 650,
    "wdth" 100;
  a {
    flex-grow: 1;
    text-align: center;
    padding-top: 1.3%;
  }
  a:hover {
    background: var(--fg);
    color: var(--bg);
    transition: 75ms;
  }
  .logo {
    padding: 0;
    background: var(--fg);
    aspect-ratio: 2 / 0.9;
    flex-grow: 0;
    width: 5%;
  }
}

@media only screen and (max-width: 800px) {
  .masthead .logo {
      display: none;
    }
  .masthead {
      padding: 0 0 var(--space-xs);
  }

</style>
